{
  "name": "busybar-webos",
  "version": "0.1.0",
  "description": "A widget runtime + web portal for the BUSY Bar — including AI-generated pixel movies on demand",
  "license": "MIT",
  "type": "module",
  "bin": {
    "busybar-webos": "bin/busybar-webos.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "widgets",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "tsx watch --exclude \"./data/**\" --exclude \"./public/**\" src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.30",
    "@ai-sdk/openai": "^4.0.30",
    "ai": "^7.0.52",
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2",
    "protobufjs": "^8.7.1",
    "swagger-ui-dist": "^5.32.12",
    "transliteration": "^2.6.1",
    "tsx": "^4.19.2",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2"
  }
}
